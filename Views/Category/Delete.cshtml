@model CRUD_Operation.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>

<h3>Are you sure you want to delete this category?</h3>

    <div>
        <p>
            <strong>Id:</strong> @Model.Id
        </p>

        <p>
            <strong>Name:</strong> @Model.name
        </p>

        <p>
            <strong>Description:</strong> @Model.description
        </p>

        <p>
            <strong>Active:</strong> @Model.isActive
        </p>

        <p>
            <strong>Created Time:</strong> @Model.createdTime
        </p>
    </div>

    <form asp-controller="Category" asp-action="Delete" asp-route-id="@Model.Id" method="post">

        <button type="submit" class="btn btn-primary">Delete Confirmed</button>

        <a asp-controller="Category" asp-action="Index" class="btn btn-primary">Cancel</a>

    </form>